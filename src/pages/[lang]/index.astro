---
import Home from '@/components/Home.astro';
import Shell from '@/layouts/Shell.astro';
import { ALT_LOCALES, t, type Locale } from '@/i18n';

export function getStaticPaths() {
	return ALT_LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const m = t(locale);
---

<Shell title={m.meta.title} description={m.meta.description} locale={locale} translated>
	<Home locale={locale} />
</Shell>
